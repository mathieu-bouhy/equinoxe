# Copy relevant values to apps/api/.env.local
AUTH_SECRET=change-this-long-random-secret-in-local-development
AUTH_TOKEN_TTL_HOURS=24
EQUINOXE_ADMIN_EMAIL=admin@example.test
EQUINOXE_ADMIN_PASSWORD=change-me-now
EQUINOXE_ADMIN_NAME=Administrateur Equinoxe
APP_DATA_DIR=../../data
# Laissez vide pour le mode fichiers JSON local. Pour partager utilisateurs et
# configurations entre environnements, définissez une URL PostgreSQL avec TLS.
# Exemple : postgres://equinoxe_app:mot-de-passe@host:5432/equinoxe?sslmode=require
DATABASE_URL=
APP_ORIGIN=http://localhost:5173
GIMI_ODOO_BASE_URL=https://odoo.example.test
GIMI_ODOO_DATABASE=gimi
# Utilisez un compte de service dédié : jamais un administrateur Odoo.
# Dans Odoo, retirez les droits Créer / Modifier / Supprimer de ce compte.
GIMI_ODOO_USERNAME=equinoxe-readonly@example.test
GIMI_ODOO_API_KEY=replace-with-api-key
# Odoo / Lonneux (mêmes champs, instance indépendante)
LONNEUX_ODOO_BASE_URL=https://odoo.example.test
LONNEUX_ODOO_DATABASE=lonneux
LONNEUX_ODOO_USERNAME=admin@example.test
LONNEUX_ODOO_API_KEY=replace-with-api-key
ODOO_RPC_TIMEOUT_MS=15000
ODOO_RPC_RETRIES=1
